# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New projects: publishable key (sb_publishable_...). Older projects: anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. (Legacy name SUPABASE_SERVICE_ROLE_KEY or new SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM ── aipipe | openai | openrouter | custom | none
LLM_PROVIDER=aipipe
# AI Pipe token from https://aipipe.org/login (free tier ≈ $0.10/week — summaries are cached per alert)
LLM_API_KEY=
# Optional overrides
# LLM_MODEL=openai/gpt-4.1-nano
# LLM_BASE_URL=https://aipipe.org/openrouter/v1
# LLM_TIMEOUT_MS=12000
